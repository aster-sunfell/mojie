# Copy to deploy/.env for local development or deploy/.env.prod for production.
# Leave these unset to use local defaults; set private values for production.
# MOJIE_DB_PASSWORD=
# MOJIE_CURSOR_KEY=

# Model API: /v1/messages or /v1/chat/completions. Other paths fail at startup.
# Base URL is an origin without /v1. These values work with SiliconFlow.
MOJIE_MODEL_API_PATH=/v1/messages
MOJIE_MODEL_BASE_URL=https://api.siliconflow.cn
# Leave the key empty for content editing only.
MOJIE_MODEL_API_KEY=

MOJIE_OWNER_ID=local-author
MOJIE_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
