# Copy to deploy/.env for local development or deploy/.env.prod for production.
# Leave these unset to use local defaults; set private values for production.
# MOJIE_DB_PASSWORD=
# MOJIE_CURSOR_KEY=

# Production images built by GitHub Actions (not needed for local development).
MOJIE_IMAGE_PREFIX=ghcr.io/aster-sunfell/mojie
# Set to the full commit SHA only after both image builds succeed.
MOJIE_IMAGE_TAG=

# Model API: /v1/messages or /v1/chat/completions. Other paths fail at startup.
# Base URL is an origin without /v1. These values work with SiliconFlow.
MOJIE_MODEL_API_PATH=/v1/chat/completions
MOJIE_MODEL_BASE_URL=https://api.siliconflow.cn
# Leave the key empty for content editing only.
MOJIE_MODEL_API_KEY=

MOJIE_OWNER_ID=local-author
MOJIE_MODEL_ID=deepseek-ai/DeepSeek-V3.2
# The V in V3.2 is required. Window from SiliconFlow's model listing.
MOJIE_MODEL_CONTEXT_TOKENS=163840
# Pro/deepseek-ai/DeepSeek-V3.2 is a separate provider model ID; record which one was tested.

# Complete Skill storage and isolated execution (local Java uses .mojie-data by default).
# MOJIE_DATA_DIR=/absolute/path/to/mojie-data
# MOJIE_SKILL_EXECUTOR_URL=http://127.0.0.1:8091
MOJIE_PYTHON_IMAGE=python@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0
MOJIE_NODE_IMAGE=node@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
MOJIE_EXECUTOR_WORK_DIR=/var/lib/mojie-executor
