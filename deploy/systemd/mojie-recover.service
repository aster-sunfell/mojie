[Unit]
Description=Recover the active Mojie deployment before enabling updates
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/mojie/scripts/mojie_deploy.py --config /etc/mojie/deploy.json recover
RemainAfterExit=yes
TimeoutStartSec=30min
UMask=0077

[Install]
WantedBy=multi-user.target
